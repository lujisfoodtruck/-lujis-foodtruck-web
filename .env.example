PORT=3000
ADMIN_PASSWORD=changeme123
SESSION_SECRET=change-this-session-secret

# --- Only needed when the backend and frontend are on different domains ---
# Set this in production (e.g. on Render) so cookies/CORS work correctly.
NODE_ENV=production
# The public URL of THIS backend once deployed, no trailing slash.
BACKEND_PUBLIC_URL=https://your-backend.onrender.com
# Comma-separated list of frontend origins allowed to call this API.
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
